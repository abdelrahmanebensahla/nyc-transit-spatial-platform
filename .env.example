# Neon Postgres connection string (pooled endpoint is fine for the app,
# use the DIRECT endpoint for the loader — it writes in large batches).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) endpoint. Used by drizzle-kit and loader/load_static.py.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# MTA subway GTFS static — SUPPLEMENTED feed, updated hourly.
# The supplemented feed carries near-term service changes; the regular feed
# does not, and RT trip_id matching needs the supplemented one.
GTFS_STATIC_URL="https://rrgtfsfeeds.s3.amazonaws.com/gtfs_supplemented.zip"

# ArcGIS Location Platform API key, from developers.arcgis.com.
# NEXT_PUBLIC_ so the browser can read it -- the SDK runs client-side and this
# key is necessarily public. Scope it to Basemaps only and set an HTTP referrer
# restriction on it; do not reuse a key that has other privileges.
# Without it the route and station layers still draw, but there is no basemap.
NEXT_PUBLIC_ARCGIS_API_KEY=""
